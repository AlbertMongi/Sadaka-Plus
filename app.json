{
  "expo": {
    "name": "Sadaka Plus",
    "slug": "sadaka-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sadaka-logo.png",
    "scheme": "sadakaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "6",
      "supportsTablet": true,
      "bundleIdentifier": "com.evmak.sadakaapp",
      "config": {
        "googleMapsApiKey": "AIzaSyBrn_XIiyIQ_4nwQsD7VJX9ltMpEXVJRws"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to help you find nearby communities and donation opportunities.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to provide personalized donation recommendations based on your area."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sadaka-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.evmak.sadakaapp",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBrn_XIiyIQ_4nwQsD7VJX9ltMpEXVJRws"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Sadaka App Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Sadaka App Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72b0fd8f-be3c-445b-ba41-f3484e23c0f9"
      }
    }
  }
}
